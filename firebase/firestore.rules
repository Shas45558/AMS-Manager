rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'shas45558@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function teacherPath() { return /databases/$(database)/documents/teacherAccounts/$(request.auth.uid); }
    function isEnabledTeacher() {
      return signedIn() && exists(teacherPath())
        && get(teacherPath()).data.role == 'teacher'
        && get(teacherPath()).data.schoolId == 'ams-manager-b1434'
        && get(teacherPath()).data.enabled == true
        && get(teacherPath()).data.assignedClass is string
        && get(teacherPath()).data.assignedSection is string
        && get(teacherPath()).data.assignedClass != ''
        && (get(teacherPath()).data.assignedSection != ''
          || (get(teacherPath()).data.assignedSections is list && get(teacherPath()).data.assignedSections.size() > 0));
    }
    function assigned(className, section) {
      return isEnabledTeacher()
        && get(teacherPath()).data.assignedClass == className
        && (get(teacherPath()).data.assignedSection == section
          || (get(teacherPath()).data.assignedSections is list && section in get(teacherPath()).data.assignedSections));
    }
    function sameOrNextClass(fromClass, toClass) {
      return fromClass == toClass
        || (fromClass == '1' && toClass == '2')
        || (fromClass == '2' && toClass == '3')
        || (fromClass == '3' && toClass == '4')
        || (fromClass == '4' && toClass == '5')
        || (fromClass == '5' && toClass == '6')
        || (fromClass == '6' && toClass == '7')
        || (fromClass == '7' && toClass == '8')
        || (fromClass == '8' && toClass == '9')
        || (fromClass == '9' && toClass == '10')
        || (fromClass == '10' && toClass == '11');
    }
    function studentInAssignment(studentId) {
      return isEnabledTeacher()
        && exists(/databases/$(database)/documents/schools/ams-manager-b1434/students/$(studentId))
        && assigned(
          get(/databases/$(database)/documents/schools/ams-manager-b1434/students/$(studentId)).data.className,
          get(/databases/$(database)/documents/schools/ams-manager-b1434/students/$(studentId)).data.section
        );
    }
    match /teacherAccounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
    match /teacherCredentials/{document=**} { allow read, write: if false; }
    match /schools/{schoolId}/students/{studentId} {
      allow read, delete: if schoolId == 'ams-manager-b1434' && (isAdmin() || assigned(resource.data.className, resource.data.section));
      allow create: if schoolId == 'ams-manager-b1434' && (isAdmin() || assigned(request.resource.data.className, request.resource.data.section));
      allow update: if schoolId == 'ams-manager-b1434' && (isAdmin() || (assigned(resource.data.className, resource.data.section) && request.resource.data.section == resource.data.section && sameOrNextClass(resource.data.className, request.resource.data.className)));
    }
    // School closures are managed by the verified admin and readable by enabled teachers
    // so attendance and individual report cards use the same shared calendar.
    match /schools/{schoolId}/schoolClosures/{closureId} {
      allow read: if schoolId == 'ams-manager-b1434' && (isAdmin() || isEnabledTeacher());
      allow create, update, delete: if schoolId == 'ams-manager-b1434' && isAdmin();
    }
    match /schools/{schoolId}/promotionHistory/{historyId} {
      allow read: if schoolId == 'ams-manager-b1434' && isAdmin();
      allow create, update: if schoolId == 'ams-manager-b1434' && (isAdmin() || assigned(request.resource.data.fromClass, request.resource.data.fromSection));
      allow delete: if schoolId == 'ams-manager-b1434' && isAdmin();
    }
    match /schools/{schoolId}/attendance/{recordId} {
      allow read, delete: if schoolId == 'ams-manager-b1434' && (isAdmin() || studentInAssignment(resource.data.studentId));
      allow create, update: if schoolId == 'ams-manager-b1434' && (isAdmin() || studentInAssignment(request.resource.data.studentId));
    }
    match /schools/{schoolId}/monthlyExams/{recordId} {
      allow read, delete: if schoolId == 'ams-manager-b1434' && (isAdmin() || studentInAssignment(resource.data.studentId));
      allow create, update: if schoolId == 'ams-manager-b1434' && (isAdmin() || studentInAssignment(request.resource.data.studentId));
    }
    match /schools/{schoolId}/examMarks/{recordId} {
      allow read, delete: if schoolId == 'ams-manager-b1434' && (isAdmin() || studentInAssignment(resource.data.studentId));
      allow create, update: if schoolId == 'ams-manager-b1434' && (isAdmin() || studentInAssignment(request.resource.data.studentId));
    }
    match /schools/{schoolId}/{document=**} {
      allow read, write: if schoolId == 'ams-manager-b1434' && isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
