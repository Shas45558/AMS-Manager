rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'shas45558@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isEnabledTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid)).data.schoolId == 'ams-manager-b1434'
        && get(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid)).data.enabled == true;
    }
    function isSchoolUser() { return isAdmin() || isEnabledTeacher(); }

    // Teacher profiles can be read by their owner and the admin, but only the
    // verified, allowlisted administrator can create/update/delete profiles.
    match /teacherAccounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }

    // Legacy credential hashes are never accessible to clients.
    match /teacherCredentials/{document=**} {
      allow read, write: if false;
    }

    match /schools/{schoolId}/{document=**} {
      allow read, write: if isSchoolUser() && schoolId == 'ams-manager-b1434';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
