rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'shas45558@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isSchoolUser() {
      return signedIn() && (
        isAdmin() ||
        (request.auth.token.role == 'teacher'
          && request.auth.token.schoolId == 'school-manager-b0578')
      );
    }

    // All school records are private. Only authenticated admin/teacher claims
    // for this school can read/write. More granular write restrictions should
    // be added if teachers must have read-only or subject-specific access.
    match /schools/{schoolId}/{document=**} {
      allow read, write: if isSchoolUser() && schoolId == 'school-manager-b0578';
    }

    // Teacher credential records must never be directly readable from clients.
    match /teacherCredentials/{document=**} {
      allow read, write: if false;
    }

    // Deny all unspecified paths by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
